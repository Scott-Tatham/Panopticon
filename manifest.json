{
  "manifest_version": 3,
  "name": "Panopticon",
  "version": "1.0",
  "description": "Finds all open YouTube video tabs and saves their links to a text file.",
  "permissions":
  [
    "tabs",
    "downloads"
  ],
  "host_permissions":
  [
    "https://*.youtube.com/*"
  ],
  "icons":
  {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action":
  {
    "default_popup": "popup.html",
	"default_icon":
	{
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}